#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# Spec-limit frontmatter checks (shared with install-skills). Fails fast.
python3 "$ROOT/bin/_check-frontmatter.py" plugins

# Repo-specific checks: authoring wording and cross-skill references.
python3 <<'PY'
import json
import pathlib
import re
import sys

import yaml

errors = []
skills = {}

for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    text = path.read_text()
    end = text.find("\n---", 4)
    data = yaml.safe_load(text[4:end]) or {}

    name = data.get("name")
    description = data.get("description")
    if description and re.search(r"\bTriggers when\b|\bauto-triggered\b|\bactivates\b", str(description), re.I):
        errors.append(f"{path}: description uses magic-trigger wording")

    if name:
        skills[name] = path

skill_ref = re.compile(r"`([a-z0-9]+(?:-[a-z0-9]+)*)`")
for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    text = path.read_text()
    for name in sorted(set(skill_ref.findall(text))):
        if name in skills:
            continue
        if "-" not in name:
            continue
        errors.append(f"{path}: references missing skill `{name}`")

if errors:
    sys.stderr.write("\n".join(errors) + "\n")
    sys.exit(1)

print(f"checked {len(skills)} skills")

for path in [pathlib.Path(".claude-plugin/marketplace.json"), *sorted(pathlib.Path("plugins").glob("*/.claude-plugin/plugin.json"))]:
    json.loads(path.read_text())
    print(f"ok {path}")
PY
