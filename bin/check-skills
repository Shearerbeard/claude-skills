#!/usr/bin/env bash
set -euo pipefail

# Usage: check-skills [ROOT] [--also KNOWN_ROOT ...]
#
# ROOT          Marketplace root whose skills get linted: frontmatter limits,
#               authoring wording, cross-skill references, and whichever JSON
#               manifests it ships. Optional; defaults to this script's own
#               repo, so a bare `check-skills` behaves exactly as it always
#               has.
# --also PATH   Another marketplace root whose skill names join the
#               known-names set for the cross-reference check only. Its
#               skills are NOT linted. Repeatable.
#
# The union exists because a skill in one source may cite a skill installed
# from another - they land side by side in ~/.agents/skills/. Without it every
# cross-source citation reads as a dangling reference.

SELF_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$SELF_ROOT"
ALSO=()
root_given=0

while [ $# -gt 0 ]; do
  case "$1" in
    --also)
      [ $# -ge 2 ] || { echo "check-skills: --also needs a path" >&2; exit 2; }
      ALSO+=("$(cd "$2" && pwd)")
      shift 2
      ;;
    -h|--help)
      sed -n '4,18p' "$0"
      exit 0
      ;;
    -*)
      echo "check-skills: unknown option $1" >&2
      exit 2
      ;;
    *)
      [ "$root_given" -eq 0 ] || { echo "check-skills: at most one ROOT" >&2; exit 2; }
      ROOT="$(cd "$1" && pwd)"
      root_given=1
      shift
      ;;
  esac
done

cd "$ROOT"

# Spec-limit frontmatter checks (shared with install-skills). Fails fast.
python3 "$SELF_ROOT/bin/_check-frontmatter.py" plugins

# Repo-specific checks: authoring wording and cross-skill references.
python3 - ${ALSO[@]+"${ALSO[@]}"} <<'PY'
import json
import pathlib
import re
import sys

import yaml

# argv carries the --also roots. They contribute known names only; nothing
# under them is linted here, because their own repo lints them.
also_roots = [pathlib.Path(p) for p in sys.argv[1:]]

errors = []
skills = {}


def frontmatter(path):
    """The SKILL.md frontmatter as a dict, or empty when it has none.

    _check-frontmatter.py has already failed the run for a malformed file
    under the linted root; the tolerance here is for the --also roots, which
    are read for names alone.
    """
    text = path.read_text()
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 4)
    if end == -1:
        return {}
    return yaml.safe_load(text[4:end]) or {}


for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    data = frontmatter(path)

    name = data.get("name")
    description = data.get("description")
    if description and re.search(r"\bTriggers when\b|\bauto-triggered\b|\bactivates\b", str(description), re.I):
        errors.append(f"{path}: description uses magic-trigger wording")

    if name:
        skills[name] = path

known = set(skills)
for other in also_roots:
    for path in sorted(other.glob("plugins/*/skills/*/SKILL.md")):
        name = frontmatter(path).get("name")
        if name:
            known.add(name)

skill_ref = re.compile(r"`([a-z0-9]+(?:-[a-z0-9]+)*)`")
for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    text = path.read_text()
    for name in sorted(set(skill_ref.findall(text))):
        if name in known:
            continue
        if "-" not in name:
            continue
        errors.append(f"{path}: references missing skill `{name}`")

if errors:
    sys.stderr.write("\n".join(errors) + "\n")
    sys.exit(1)

print(f"checked {len(skills)} skills")

for path in [pathlib.Path(".claude-plugin/marketplace.json"), *sorted(pathlib.Path("plugins").glob("*/.claude-plugin/plugin.json"))]:
    if not path.is_file():
        continue
    json.loads(path.read_text())
    print(f"ok {path}")
PY
