#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

python3 <<'PY'
import json
import pathlib
import re
import sys

import yaml

errors = []
skills = {}

for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    text = path.read_text()
    if not text.startswith("---\n"):
        errors.append(f"{path}: missing YAML frontmatter")
        continue
    end = text.find("\n---", 4)
    if end == -1:
        errors.append(f"{path}: missing YAML frontmatter terminator")
        continue
    try:
        data = yaml.safe_load(text[4:end]) or {}
    except yaml.YAMLError as exc:
        errors.append(f"{path}: invalid YAML in frontmatter: {exc}")
        continue

    name = data.get("name")
    description = data.get("description")
    skill_dir = path.parent.name

    if not name:
        errors.append(f"{path}: missing name")
    elif name != skill_dir:
        errors.append(f"{path}: name {name!r} does not match directory {skill_dir!r}")
    if not str(description or "").strip():
        errors.append(f"{path}: missing description")
    elif len(str(description)) > 1024:
        errors.append(f"{path}: description is {len(str(description))} chars; OpenCode allows 1024")
    if description and re.search(r"\bTriggers when\b|\bauto-triggered\b|\bactivates\b", str(description), re.I):
        errors.append(f"{path}: description uses magic-trigger wording")

    if name:
        skills[name] = path

skill_ref = re.compile(r"`([a-z0-9]+(?:-[a-z0-9]+)*)`")
for path in sorted(pathlib.Path("plugins").glob("*/skills/*/SKILL.md")):
    text = path.read_text()
    for name in sorted(set(skill_ref.findall(text))):
        if name in skills:
            continue
        if "-" not in name:
            continue
        errors.append(f"{path}: references missing skill `{name}`")

if errors:
    sys.stderr.write("\n".join(errors) + "\n")
    sys.exit(1)

print(f"checked {len(skills)} skills")

for path in [pathlib.Path(".claude-plugin/marketplace.json"), *sorted(pathlib.Path("plugins").glob("*/.claude-plugin/plugin.json"))]:
    json.loads(path.read_text())
    print(f"ok {path}")
PY
